# Copia este archivo como .env (ignorado por git) y rellena las claves.
# Nunca subas .env al repositorio ni pegues claves en documentos o commits.

# OpenAI: generación y edición de imagen
OPENAI=
# Modelo de imagen (no es secreto; por defecto gpt-image-2.6-sunburst)
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst

# ElevenLabs: música, efectos y voces
ELEVENLABS=

# Opcionales, cuando hagan falta
# Google AI Studio: Gemini / Imagen
GEMINI=
# Replicate: modelos abiertos, entrenamiento de estilo, eliminación de fondo y escalado
REPLICATE=
# Magnific: escalado y detalle
MAGNIFIC=
